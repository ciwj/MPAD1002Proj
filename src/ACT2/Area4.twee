/* ACT II - AREA 4    */
/* DARK PUZZLE ROOM   */
/**********************/

:: darkPuzzleRoom S

darkPuzzleRoom pov s wall

[[forwards| Area4Room2 S]]
[[turn right|darkPuzzleRoom W]]
[[turn left| darkPuzzleRoom E]]

:: darkPuzzleRoom E

darkPuzzleRoom pov E wall

[[forwards| Area4Room1 E]]
[[turn right|darkPuzzleRoom S]]
[[turn left| darkPuzzleRoom N]]

:: darkPuzzleRoom N

darkPuzzleRoom pov n wall

[[forwards| Area2Room2 N]]
[[turn right|darkPuzzleRoom E]]
[[turn left| darkPuzzleRoom W]]

:: darkPuzzleRoom W

darkPuzzleRoom pov W wall

[[turn right|darkPuzzleRoom N]]
[[turn left| darkPuzzleRoom S]]


