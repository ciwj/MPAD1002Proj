  [[turn left| Area3Room2 W]]


:: Area3Room2 E
  <img src="src/assets/img/act 2 transitional rooms/Area3Room2PovE.png" width="400" alt="[]"/>
    [[forward|Area4Room2 E]]
    [[turn right| Area3Room2 W]]
    [[turn left| Area3Room2 E]]


