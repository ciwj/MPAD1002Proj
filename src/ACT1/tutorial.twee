    <button class="inventory_slot hidden"> Item 3 </button>
    <button class="inventory_slot hidden"> Item 4 </button>
    <button class="inventory_slot hidden"> Item 5 </button>

    </div>
</div>

<<if $inventory <[2]>>
  grab a [[banana|grab_banana]]
  grab a [[cookie|grab_cookie]]
  grab an [[anchovy|grab_anchovy]]
  grab [[nothing|brown_bin]]
<</if>>

<<if $inventory == [2]>>
  your hands are full
<</if>>

[[step back | kitchen_tutorial]]


:: grab_banana
<<set $ITEMbanana++>>
<<set $inventory ++>>
<<goto brown_bin>>

:: drop_banana
<<set $ITEMbanana-->>
<<set $inventory-->>
<<goto green_bin>>

:: grab_cookie
<<set $ITEMcookie++>>
<<set $inventory ++>>
<<goto brown_bin>>

:: drop_cookie
<<set $ITEMcookie-->>
<<set $inventory-->>
<<goto green_bin>>

:: grab_anchovy
<<set $ITEManchovy++>>
<<set $inventory ++>>
<<goto brown_bin>>

:: drop_anchovy
<<set $ITEManchovy-->>
<<set $inventory-->>
<<goto green_bin>>

<!-- drop soups start -->

