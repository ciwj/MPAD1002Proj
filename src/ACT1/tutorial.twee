:: radio
 <img src="src/assets/img/tutorial_music.jpg" width="240" height="auto" alt="[alt text goes here]"/>

songNumer = $songNumber

<<if $songNumber == 1>>
<<cacheaudio "song1" "src/assets/audio/tutorial_music_song1.mp3">>
<<audio "song1" play goto "music tutorial">>
<</if>>

<<if $songNumber == 2>>
<<cacheaudio "song2" "src/assets/audio/tutorial_music_song2.mp3">>
<<audio "song2" play goto "music tutorial">>
<</if>>

<<if $songNumber == 3>>
<<cacheaudio "song3" "src/assets/audio/tutorial_music_song3.mp3">>
<<audio "song3" play goto "music tutorial">>
<</if>>

<<if $songNumber == 4>>
<<cacheaudio "song4" "src/assets/audio/tutorial_music_song4.mp3">>
<<audio "song4" play goto "music tutorial">>
<</if>>
...

