:: grab_banana
<<set $ITEMbanana++>>
<<set $inventory ++>>
<<goto brown_bin>>

:: drop_banana
<<set $ITEMbanana-->>
<<set $inventory-->>
<<goto green_bin>>

:: grab_cookie
<<set $ITEMcookie++>>
<<set $inventory ++>>
<<goto brown_bin>>

:: drop_cookie
<<set $ITEMcookie-->>
<<set $inventory-->>
<<goto green_bin>>

:: grab_anchovy
<<set $ITEManchovy++>>
<<set $inventory ++>>
<<goto brown_bin>>

:: drop_anchovy
