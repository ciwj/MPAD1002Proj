<<if ($hexagonLock == ['True']) and ($circleLock == ['True']) /* and ($triangleLock == ['True'])*/ and ($diamondLock == ['True']) /*and ($pentagonLock == ['True'])*/ >>
  <<goto unlocked_door>>
<</if>>


