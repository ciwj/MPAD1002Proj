:: cook_banana
<<if $ITEMbanana == 2>>
<<run $tutorialCookingPot.push('banana2')>>
<</if>>
<<if $ITEMbanana == 1>>
  <<if $tutorialCookingPot.includes ('banana2')>>
  <<run $tutorialCookingPot.push('banana')>>
  <<else>>
    <<run $tutorialCookingPot.push('banana2')>>
  <</if>>
<</if>>
<<set$inventory-->>
<<set $ITEMbanana-->>
<<set $tutorialIngredients ++>>
<<goto cooking_pot>>

:: cook_cookie
<<if $ITEMcookie == 2>>
<<run $tutorialCookingPot.push('cookie2')>>
<</if>>
<<if $ITEMcookie == 1>>
  <<if $tutorialCookingPot.includes ('cookie2')>>
  <<run $tutorialCookingPot.push('cookie')>>
  <<else>>
    <<run $tutorialCookingPot.push('cookie2')>>
  <</if>>
<</if>>
<<set$inventory-->>
<<set $ITEMcookie-->>
<<set $tutorialIngredients ++>>
<<goto cooking_pot>>

:: cook_anchovy
<<if $ITEManchovy == 2>>
<<run $tutorialCookingPot.push('anchovy2')>>
<</if>>
<<if $ITEManchovy == 1>>
  <<if $tutorialCookingPot.includes ('anchovy2')>>
  <<run $tutorialCookingPot.push('anchovy')>>
  <<else>>
    <<run $tutorialCookingPot.push('anchovy2')>>
  <</if>>
<</if>>
<<set$inventory-->>
<<set $ITEManchovy-->>
<<set $tutorialIngredients ++>>
<<goto cooking_pot>>

:: take_soup
<<if (($tutorialCookingPot.includes('banana2')) and ($tutorialCookingPot.includes('banana')))>>
