<<if $tutorialIngredients == 0>>
  <<else>>
    items in the pot:
    $tutorialCookingPot
<</if>>
</div>

<<if ($tutorialIngredients == 2)>>
  the ingredients have mixed!
  <<if $ITEMplate == 0>>
    if only you had something to carry it with...
  <</if>>
  <<if $ITEMplate==1>>
    take [[soup|take_soup]] 
  <</if>>
<</if>>

[[take a step back|kitchen_tutorial]]

:: cook_banana
<<if $ITEMbanana == 2>>
<<run $tutorialCookingPot.push('banana2')>>
<</if>>
<<if $ITEMbanana == 1>>
  <<if $tutorialCookingPot.includes ('banana2')>>
  <<run $tutorialCookingPot.push('banana')>>
  <<else>>
    <<run $tutorialCookingPot.push('banana2')>>
  <</if>>
<</if>>
<<set$inventory-->>
<<set $ITEMbanana-->>
<<set $tutorialIngredients ++>>
<<goto cooking_pot>>

:: cook_cookie
<<if $ITEMcookie == 2>>
<<run $tutorialCookingPot.push('cookie2')>>
<</if>>
<<if $ITEMcookie == 1>>
  <<if $tutorialCookingPot.includes ('cookie2')>>
  <<run $tutorialCookingPot.push('cookie')>>
  <<else>>
    <<run $tutorialCookingPot.push('cookie2')>>
  <</if>>
<</if>>
<<set$inventory-->>
<<set $ITEMcookie-->>
<<set $tutorialIngredients ++>>
<<goto cooking_pot>>

:: cook_anchovy
