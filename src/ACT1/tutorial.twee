:: circuit_tutorial
circuit number: $circuitNumber
circuitRoomState: $circuitRoomState

<<if $circuitRoomState == 1>>

<div class ="inventory_layout">
<img src="src/assets/img/rooms/tutorial_circuit disconnected.jpg" width="800" alt="[]"/>

    <div class="inventory"> 

    <button class="inventory_slot"> Item 1 </button>
    <button class="inventory_slot"> Item 2 </button>
    <button class="inventory_slot hidden"> Item 3 </button>
    <button class="inventory_slot hidden"> Item 4 </button>
    <button class="inventory_slot hidden"> Item 5 </button>

    </div>
</div>

[[pick up the wire]]

[[go back|starting_room 2]]
<</if>>

<<if $circuitRoomState == 2>>

<div class ="inventory_layout">
<img src="src/assets/img/rooms/tutorial_circuit picked up.jpg" width="800" alt="[]"/>

    <div class="inventory"> 

    <button class="inventory_slot"> Item 1 </button>
    <button class="inventory_slot"> Item 2 </button>
    <button class="inventory_slot hidden"> Item 3 </button>
    <button class="inventory_slot hidden"> Item 4 </button>
    <button class="inventory_slot hidden"> Item 5 </button>

    </div>
</div>

