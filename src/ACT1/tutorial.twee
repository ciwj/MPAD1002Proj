\> Inside the bin there are cookies, bananas and anchovies. An assortment, to be sure.

<div class ="inventory_layout">
    <div style="display:flex;flex-direction:row;justify-content:flex-start;">
      <img src="src/assets/img/food and soup/base foods/cookie.png" width="240" alt="[]"/>
      <img src="src/assets/img/food and soup/base foods/banana.png" width="240" alt="[]"/>
      <img src="src/assets/img/food and soup/base foods/anchovy.png" width="240" alt="[]"/>
    </div>
    <div class="inventory"> 

    <h3 class="inventory_header"><<= $name>>'s Inventory</h3>

    <button class="inventory_slot">
        <<if $ITEMbanana > 0>>
    <img src="src/assets/img/food and soup/base foods/banana.png" class="inventory_img" alt="Banana">
      <<else>>
    <img src="src/assets/img/misc items" class="inventory_img" alt="Empty Slot">
       <</if>>
    </button>
   <button class="inventory_slot">
      <<if $ITEMcookie > 0>>
        <img src="src/assets/img/food and soup/base foods/cookie.png" class="inventory_img" alt="Cookie">
      <<else>>
        <img src="src/assets/img/misc items/" class="inventory_img" alt="Empty Slot">
      <</if>>
</button>
      <button class="inventory_slot">
      <<if $ITEManchovy > 0>>
        <img src="src/assets/img/food and soup/base foods/anchovy.png" class="inventory_img" alt="Anchovy">
      <<else>>
        <img src="src/assets/img/misc items/" class="inventory_img" alt="Empty Slot">
      <</if>>
</button>
    <button class="inventory_slot hidden">
      <img src="src/assets/img/misc items/mic.png" class="inventory_img hidden" alt="Inventory Image">
    </button>
    <button class="inventory_slot hidden">
      <img src="src/assets/img/misc items/plate.png" class="inventory_img hidden" alt="Inventory Image">
    </button>

    </div>
