/*diamond and circuit tutorial*/<<set $diamondDial to [1]>> <<set $diamondLock to ['False']>> <<set $circuitRoomState to [1]>> <<set $circuitNumber to [1,2,3,4,5,6,7,8].random()>> <<set $hasWire to ['False']>>
